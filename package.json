{
  "name": "election-map-studio",
  "version": "2.0.0",
  "private": true,
  "description": "World and sub-national election map maker",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build:admin1": "node scripts/build-admin1.js",
    "build:admin1:50m": "node scripts/build-admin1.js --res 50m",
    "test": "playwright test",
    "fetch:parlgov": "node scripts/fetch-parlgov.js",
    "build:parlgov": "node scripts/build-parlgov.js",
    "build:boundaries": "node scripts/build-geoboundaries.js",
    "build:constituencies": "node scripts/build-constituencies.js",
